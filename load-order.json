                                "state": "EX",
                                "postalCode": "000000",
                                "country": "IN"
                            },
                            "billTo": {
                                "companyName": "Example Buyer Ltd",
                                "addressLine1": "1 Example Business Park",
                                "city": "Example City",
                                "state": "EX",
                                "postalCode": "000000",
                                "country": "IN"
                            },
                            "items": [
                                {
                                    "lineNumber": 1,
                                    "itemCode": "CU-ROD-10MM",
                                    "description": "Copper Rod 10mm",
                                    "quantity": 500,
                                    "uom": "KG",
                                    "unitPrice": 720.5,
                                    "currency": "INR",
                                    "lineAmount": 360250,
                                    "deliveryDate": "2026-01-15"
                                },
                                {
                                    "lineNumber": 2,
                                    "itemCode": "AL-SHEET-5MM",
                                    "description": "Aluminium Sheet 5mm",
                                    "quantity": 300,
                                    "uom": "KG",
                                    "unitPrice": 210,
                                    "currency": "INR",
                                    "lineAmount": 63000,
                                    "deliveryDate": "2026-01-20"
                                }
                            ],
                            "summary": {
                                "subTotal": 423250,
                                "tax": {
                                    "taxType": "GST",
